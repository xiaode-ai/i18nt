{
  "name": "@xiaode-ai/i18nt",
  "version": "1.0.2",
  "description": "极致轻量的国际化框架 — 零依赖 · Proxy 驱动 · Intl 标准化 · RTL 自适应",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaode-ai/i18nt.git"
  },
  "bugs": {
    "url": "https://github.com/xiaode-ai/i18nt/issues"
  },
  "homepage": "https://github.com/xiaode-ai/i18nt#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "bin": {
    "i18nt": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "export": "node bin/cli.js export",
    "test": "vitest run"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "react",
    "lightweight",
    "proxy",
    "intl",
    "rtl"
  ],
  "author": "xiaode-ai",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
